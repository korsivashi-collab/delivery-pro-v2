rules_version = '2';

// Local draft only. No Firebase deployment configuration is supplied here.
service cloud.firestore {
  match /databases/{database}/documents {
    function principal() {
      return get(/databases/$(database)/documents/auth_principals/$(request.auth.uid)).data;
    }
    function account(p) {
      let parts = p.accountRef.split('/');
      return get(/databases/$(database)/documents/$(parts[0])/$(parts[1])).data;
    }
    function knownLicense(d) {
      return !('securityVersion' in d) || d.securityVersion == 1;
    }
    function unexpired(value) {
      let parts = value.split('[.-]');
      return value is string && value.matches('^[0-9]{4}([.][0-9]{2}[.][0-9]{2}|-[0-9]{2}-[0-9]{2})$') &&
        request.time < timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) + duration.value(15, 'h');
    }
    function validIdentity(p) {
      return p.enabled == true && p.credentialReady == true && p.credentialVersion is int && p.credentialVersion > 0 &&
        request.auth.token.credentialVersion == p.credentialVersion && p.accountRef is string &&
        !(p.accountRef.split('/')[1] in ['.', '..']) &&
        ((p.role == 'master' && p.accountRef.matches('^(admin|admins)/[^/]+$')) ||
         (p.role in ['driver', 'dispatch'] && p.accountRef.matches('^licenses/[^/]+$')));
    }
    function validAccount(p, a) {
      return p.role == 'master' ? a.get('enabled', true) != false && a.get('status', 'active') == 'active' &&
        (!('expireDate' in a) || unexpired(a.expireDate)) :
        knownLicense(a) && a.status == 'active' && unexpired(a.expireDate) &&
        (p.role == 'dispatch' ? a.type == 'dispatch' : a.get('type', 'regular') in ['regular', 'trial']);
    }
    function authenticated() {
      let p = principal();
      return request.auth != null && validIdentity(p) && validAccount(p, account(p));
    }
    function master() { return authenticated() && principal().role == 'master'; }
    function dispatch() { return authenticated() && principal().role == 'dispatch'; }
    function driver() { return authenticated() && principal().role == 'driver'; }
    function companyId() { return principal().accountRef.split('/')[1]; }
    function ownLicense(id) { return principal().accountRef == 'licenses/' + id; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function territoryUpdate() {
      return changedOnly(['territoryLat', 'territoryLng', 'territoryScale', 'territory1', 'territory2', 'territorySize']);
    }
    function usableOwner(a) { return a.get('routeOwnerId', '') is string && a.get('routeOwnerId', '') != ''; }
    function ownRoute(r) {
      let a = account(principal());
      return usableOwner(a) && r.routeOwnerId == a.routeOwnerId;
    }
    function companyRoute(r) {
      return r.dispatchKey == companyId() && r.licenseKey is string &&
        get(/databases/$(database)/documents/licenses/$(r.licenseKey)).data.dispatchKey == companyId();
    }
    function validRouteWrite(id) {
      let r = request.resource.data;
      let p = principal();
      let a = get(/databases/$(database)/documents/licenses/$(r.licenseKey)).data;
      return authenticated() && r.licenseKey is string && !r.licenseKey.matches('.*[/].*') && knownLicense(a) && a.type in ['regular', 'trial'] &&
        a.status == 'active' && unexpired(a.expireDate) && usableOwner(a) && r.routeOwnerId == a.routeOwnerId &&
        r.dispatchKey == a.get('dispatchKey', '') && r.deviceId == id &&
        (a.get('deviceId', '') == '' ? id == r.licenseKey : a.deviceId == id) &&
        ((p.role == 'driver' && ownLicense(r.licenseKey)) || p.role == 'master' || (p.role == 'dispatch' && a.dispatchKey == companyId())) &&
        r.destinations is list && r.updatedAt is number &&
        (p.role != 'driver' || !exists(/databases/$(database)/documents/blocked_devices/$(id)));
    }
    function routeFields() {
      return ['routeOwnerId', 'licenseKey', 'dispatchKey', 'deviceId', 'phone', 'updatedAt', 'destinations',
        'endLocation', 'startSelected', 'startLocation', 'cleared'];
    }

    match /auth_principals/{id} { allow read, write: if false; }
    match /auth_secret_lookups/{id} { allow read, write: if false; }
    match /admin/{id} { allow read, write: if false; }
    match /admins/{id} { allow read, write: if false; }

    match /licenses/{id} {
      allow get: if master() || (authenticated() && ownLicense(id)) || (dispatch() && resource.data.dispatchKey == companyId());
      allow list: if master() || (dispatch() && resource.data.dispatchKey == companyId());
      allow create, delete: if false;
      allow update: if knownLicense(resource.data) && knownLicense(request.resource.data) &&
        ((driver() && ownLicense(id) && changedOnly(['deviceId', 'phone']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deviceId']) ||
            (request.resource.data.deviceId is string && (request.resource.data.deviceId == '' ||
              !exists(/databases/$(database)/documents/blocked_devices/$(request.resource.data.deviceId))))) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone']) || request.resource.data.phone is string)) ||
         (dispatch() && ownLicense(id) && changedOnly(['activeSessions', 'currentSessionToken', 'lastLoginAt']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeSessions']) || request.resource.data.activeSessions is list) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentSessionToken']) || request.resource.data.currentSessionToken is string) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastLoginAt']) || request.resource.data.lastLoginAt is number)) ||
         ((master() || (dispatch() && resource.data.dispatchKey == companyId())) &&
          resource.data.get('type', 'regular') in ['regular', 'trial'] && territoryUpdate()));
    }
    match /routes/{id} {
      allow read: if master() || (driver() && ownRoute(resource.data)) || (dispatch() && companyRoute(resource.data));
      allow create: if validRouteWrite(id) && request.resource.data.keys().hasOnly(routeFields());
      allow update: if validRouteWrite(id) && usableOwner(resource.data) &&
        resource.data.routeOwnerId == request.resource.data.routeOwnerId && changedOnly(routeFields());
      allow delete: if false;
    }
    match /dispatch_templates/{id} {
      allow read, delete: if master() || (dispatch() && resource.data.dispatchKey == companyId());
      allow create: if master() || (dispatch() && request.resource.data.dispatchKey == companyId());
      allow update: if master() || (dispatch() && resource.data.dispatchKey == companyId() && request.resource.data.dispatchKey == companyId());
    }
    match /blocked_devices/{id} {
      // Documents contain administrator memo fields; Rules cannot redact fields.
      allow read, write: if master();
    }

    // Explicitly retained, out-of-scope baseline from the supplied existing Rules.
    // These collections are NOT covered by the suspended-account/isolation guarantees.
    match /gps_reports/{id} { allow read, write: if true; }
    match /gps_requests/{id} { allow read, write: if true; }
    match /dispatch_messages/{id} { allow read, write: if true; }
    match /dispatch_orders/{id} { allow read, write: if true; }
    match /completions/{id} { allow read, write: if true; }
    match /memos/{id} { allow read, write: if true; }
    match /temp_memo_backups/{id} { allow read, write: if true; }
    // completion_operations was absent in the supplied Rules: remains default deny.
  }
}
