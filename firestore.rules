rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Paid route budget and cached results are managed only by the server.
    match /route_optimization_usage/{accountId} {
      allow read, write: if false;
    }

    match /billing_accounts/{id} { allow read, write: if false; }
    match /billing_customer_ids/{id} { allow read, write: if false; }
    match /billing_license_bindings/{id} { allow read, write: if false; }
    match /billing_events/{id} { allow read, write: if false; }
    match /payment_orders/{id} { allow read, write: if false; }
    match /dispatch_wallets/{id} { allow read, write: if false; }
    match /dispatch_payment_orders/{id} { allow read, write: if false; }
    match /dispatch_billing_events/{id} { allow read, write: if false; }
    match /dispatch_registrations/{id} { allow read, write: if false; }
    // Customer tracking capabilities and shared snapshots are server-only.
    match /delivery_tracking_tokens/{id} { allow read, write: if false; }
    match /delivery_tracking_publications/{id} { allow read, write: if false; }
    function isStoreLicense(key) {
      return exists(/databases/$(database)/documents/billing_license_bindings/$(key));
    }

    function isVerifiedMaster() {
      return request.auth != null && request.auth.token.get('role', '') == 'MASTER' &&
        request.auth.token.get('masterSmsVerified', false) == true &&
        request.auth.token.get('masterSessionExpiresAt', 0) > request.time.toMillis() / 1000;
    }

    // MASTER는 키 + SMS 검증이 완료된 유효 세션만 인정합니다.
    function isWebAdmin() {
      return isVerifiedMaster() ||
        (request.auth != null && isCurrentDispatcher());
    }

    // Paid licenses keep billing fields server-only; operational changes are scoped below.
    function ownsPaidLicense(key) {
      return request.auth != null &&
        isStoreLicense(key) &&
        get(/databases/$(database)/documents/billing_license_bindings/$(key)).data.uid == request.auth.uid &&
        (request.auth.token.firebase.sign_in_provider == 'phone' ||
          (request.auth.token.firebase.sign_in_provider == 'custom' &&
            request.auth.token.get('nativePhoneVerified', false) == true));
    }

    function isCurrentDispatcher() {
      let dispatcher = get(/databases/$(database)/documents/licenses/$(request.auth.uid)).data;
      return request.auth.token.get('role', '') == 'DISPATCH' &&
        dispatcher.get('type', '') == 'dispatch' &&
        !(dispatcher.get('status', '') in ['suspended', 'revoked', 'expired']) &&
        (!('expiresAt' in dispatcher) || dispatcher.expiresAt == null ||
          (dispatcher.expiresAt is int && dispatcher.expiresAt > request.time.toMillis()) ||
          (dispatcher.expiresAt is timestamp && dispatcher.expiresAt > request.time)) &&
        (!('expireDate' in dispatcher) || dispatcher.expireDate == '' ||
          int(dispatcher.expireDate.replace('[^0-9]', '')) >=
            (request.time + duration.value(9, 'h')).year() * 10000 +
            (request.time + duration.value(9, 'h')).month() * 100 +
            (request.time + duration.value(9, 'h')).day());
    }

    function paidOperationalUpdate(key) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.get('dispatchKey', '');
      let after = request.resource.data.get('dispatchKey', '');
      return (ownsPaidLicense(key) && changed.hasOnly(['allowTms', 'dispatchKey']) &&
          request.resource.data.allowTms is bool &&
          (after == before || (request.resource.data.allowTms == false && after == ''))) ||
        (resource.data.get('type', '') != 'dispatch' &&
          (isVerifiedMaster() || (request.auth != null && isCurrentDispatcher())) &&
          ((changed.hasOnly(['dispatchKey']) && after is string &&
            (after == '' || !(resource.data.get('allowTms', true) in [false, 'false'])) &&
            (isVerifiedMaster() || (before == request.auth.uid && after == ''))) ||
           (changed.hasOnly(['territoryLat', 'territoryLng', 'territoryScale',
             'territory1', 'territory2', 'territorySize']) &&
             (isVerifiedMaster() || before == request.auth.uid))));
    }

    // Session claims cannot be recreated by an old handset after a handoff.
    function isActiveDriver() {
      let key = request.auth.token.get('driverKey', '');
      let account = get(/databases/$(database)/documents/licenses/$(key)).data;
      return request.auth != null && key != '' &&
        account.get('driverUid', '') == request.auth.uid &&
        account.get('driverSessionId', '') == request.auth.token.get('driverSessionId', '-') &&
        account.get('deviceId', '') == request.auth.token.get('driverDeviceId', '-') &&
        (!request.auth.token.get('testDriverSession', false) ||
          (account.get('testSmsBypass', false) == true && account.get('type', '') == 'regular')) &&
        !(account.get('status', '') in ['suspended', 'revoked', 'expired', 'upgraded']) &&
        (!('expiresAt' in account) || account.expiresAt == null ||
          (account.expiresAt is int && account.expiresAt > request.time.toMillis()) ||
          (account.expiresAt is timestamp && account.expiresAt > request.time)) &&
        (!('expireDate' in account) || account.expireDate == '' ||
          int(account.expireDate.replace('[^0-9]', '')) >=
          (request.time + duration.value(9, 'h')).year() * 10000 +
          (request.time + duration.value(9, 'h')).month() * 100 +
          (request.time + duration.value(9, 'h')).day());
    }
    function driverOwns(owner) {
      return isActiveDriver() && get(/databases/$(database)/documents/licenses/$(request.auth.token.driverKey)).data.routeOwnerId == owner;
    }
    function driverSettings(key) {
      return isActiveDriver() && request.auth.token.driverKey == key &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowTms', 'dispatchKey']) &&
        request.resource.data.allowTms is bool &&
        (request.resource.data.get('dispatchKey', '') == resource.data.get('dispatchKey', '') ||
          (request.resource.data.allowTms == false && request.resource.data.get('dispatchKey', '') == ''));
    }

    // These indexes are maintained by the authenticated server, never by clients.
    match /access_owners/{id} { allow read, write: if false; }
    match /access_devices/{id} { allow read, write: if false; }
    function dispatchOwnsLicense(key) {
      return request.auth != null && isCurrentDispatcher() &&
        get(/databases/$(database)/documents/licenses/$(key)).data.get('dispatchKey', '') == request.auth.uid;
    }
    function dispatchOwnsOwner(owner) {
      let key = get(/databases/$(database)/documents/access_owners/$(owner)).data.licenseKey;
      return dispatchOwnsLicense(key) && get(/databases/$(database)/documents/licenses/$(key)).data.routeOwnerId == owner;
    }
    function dispatchOwnsDevice(id) {
      let mapping = get(/databases/$(database)/documents/access_devices/$(id)).data;
      let account = get(/databases/$(database)/documents/licenses/$(mapping.licenseKey)).data;
      return dispatchOwnsLicense(mapping.licenseKey) && account.routeOwnerId == mapping.routeOwnerId &&
        (id == mapping.licenseKey || id == account.get('deviceId', ''));
    }
    function driverDevice(id) {
      return isActiveDriver() && (request.auth.token.driverDeviceId == id || request.auth.token.driverKey == id);
    }
    function readsOwnLicense(key) {
      return request.auth != null && ((request.auth.token.get('driverKey', '') == key &&
        (!exists(/databases/$(database)/documents/licenses/$(key)) ||
          get(/databases/$(database)/documents/licenses/$(key)).data.get('driverUid', '') == request.auth.uid)) ||
        (request.auth.token.get('role', '') == 'DISPATCH' && request.auth.uid == key));
    }
    function ownDispatchSession(key) {
      let configured = resource.data.get('maxSessions', 0);
      let maximum = configured is int && configured > 0 ? configured :
        (configured is string && configured.matches('^[1-9][0-9]*$') ? int(configured) :
          (resource.data.get('isPro', false) ? 2 : 1));
      return request.auth != null && request.auth.uid == key && isCurrentDispatcher() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSessionToken', 'activeSessions', 'lastLoginAt']) &&
        request.resource.data.get('activeSessions', []) is list &&
        request.resource.data.get('activeSessions', []).size() <= maximum;
    }
    function readsOwner(owner) { return isVerifiedMaster() || driverOwns(owner) || dispatchOwnsOwner(owner); }

    function validCompletion(data) {
      return data.keys().hasAll(['routeOwnerId', 'deviceId', 'completedAt']) &&
        data.routeOwnerId is string && data.routeOwnerId.size() > 0 &&
        data.deviceId is string && data.deviceId.size() > 0 &&
        data.completedAt is int && data.completedAt >= 0 &&
        (!('expireAt' in data) ||
          (data.expireAt is timestamp &&
            data.expireAt.toMillis() == data.completedAt + 1209600000)) &&
        !data.keys().hasAny(['dispatchKey']);
    }

    function completionOperationMatches(completionId, ownerId, action) {
      let operationPath = /databases/$(database)/documents/completion_operations/$(completionId);
      return existsAfter(operationPath) &&
        getAfter(operationPath).data.routeOwnerId == ownerId &&
        getAfter(operationPath).data.action == action;
    }

    function validCompletionOperation(data) {
      return data.keys().hasAll(['routeOwnerId', 'action']) &&
        data.keys().hasOnly(['routeOwnerId', 'action']) &&
        data.routeOwnerId is string && data.routeOwnerId.size() > 0 &&
        data.action in ['complete', 'delete'];
    }

    function completionDeletionMatches(completionId) {
      let operationPath = /databases/$(database)/documents/completion_operations/$(completionId);
      let completionPath = /databases/$(database)/documents/completions/$(completionId);
      return existsAfter(operationPath) &&
        validCompletionOperation(getAfter(operationPath).data) &&
        getAfter(operationPath).data.action == 'delete' &&
        (!exists(completionPath) ||
          get(completionPath).data.routeOwnerId == getAfter(operationPath).data.routeOwnerId);
    }

    function operationResultMatches(operationId, data) {
      let completionPath = /databases/$(database)/documents/completions/$(operationId);
      return (data.action == 'delete' && !existsAfter(completionPath)) ||
        (data.action == 'complete' && existsAfter(completionPath) &&
          getAfter(completionPath).data.routeOwnerId == data.routeOwnerId &&
          validCompletion(getAfter(completionPath).data));
    }

    // 1. 관리자 로그인 계정은 서버 인증 API에서만 조회합니다.
    match /admin/{docId} {
      allow get: if false;
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /admins/{docId} {
      allow get: if false;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 2. 본인/연결된 기사 조회와 필요한 운영 필드 변경만 허용합니다.
    match /licenses/{licenseKey} {
      allow get: if isVerifiedMaster() || readsOwnLicense(licenseKey) || dispatchOwnsLicense(licenseKey) || ownsPaidLicense(licenseKey);
      allow list: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && resource.data.get('dispatchKey', '') == request.auth.uid);
      // Account deletion must remove its profile in the master server transaction.
      allow delete: if false;
      // SMS 검증과 중복 판정을 우회한 클라이언트 직접 체험 발급을 차단합니다.
      allow create: if isVerifiedMaster();
      allow update: if driverSettings(licenseKey) || paidOperationalUpdate(licenseKey) ||
        ownDispatchSession(licenseKey) ||
        (!isStoreLicense(licenseKey) && isVerifiedMaster() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['driverUid', 'driverSessionId', 'testSmsBypass', 'dispatchBillingId']) &&
          (!('routeOwnerId' in resource.data) || request.resource.data.routeOwnerId == resource.data.routeOwnerId));
    }

    match /driver_profiles/{profileId} {
      allow get: if isVerifiedMaster() || readsOwnLicense(profileId) || dispatchOwnsLicense(profileId) || ownsPaidLicense(profileId);
      allow list: if isVerifiedMaster();
      allow create, delete: if false;
      allow update: if driverSettings(profileId) ||
        (isStoreLicense(profileId) && ownsPaidLicense(profileId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowTms']) &&
          request.resource.data.allowTms is bool &&
          getAfter(/databases/$(database)/documents/licenses/$(profileId)).data.allowTms == request.resource.data.allowTms) || (isVerifiedMaster() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['driverUid', 'driverSessionId']) &&
          (!('routeOwnerId' in resource.data) || request.resource.data.routeOwnerId == resource.data.routeOwnerId));
    }

    // 3. 차단 목록은 마스터만 관리하며 로그인 차단 확인은 서버에서 수행합니다.
    match /blocked_devices/{deviceId} {
      allow read: if isVerifiedMaster();
      allow write: if isVerifiedMaster();
    }

    // 4. 배송 경로, GPS 보고, 위치 요청: 기사와 관제 실시간 통신
    match /routes/{docId} {
      allow get: if isVerifiedMaster() || (!exists(/databases/$(database)/documents/routes/$(docId)) &&
        (driverDevice(docId) || dispatchOwnsDevice(docId))) || readsOwner(resource.data.routeOwnerId);
      allow list: if readsOwner(resource.data.routeOwnerId);
      allow create, update: if request.resource.data.deviceId == docId &&
        (isVerifiedMaster() || (driverOwns(request.resource.data.routeOwnerId) && request.auth.token.driverDeviceId == docId) ||
          (dispatchOwnsOwner(request.resource.data.routeOwnerId) &&
            ((dispatchOwnsDevice(docId) && get(/databases/$(database)/documents/access_devices/$(docId)).data.routeOwnerId == request.resource.data.routeOwnerId) ||
              (exists(/databases/$(database)/documents/routes/$(docId)) && resource.data.routeOwnerId == request.resource.data.routeOwnerId))));
      allow delete: if isVerifiedMaster() || dispatchOwnsOwner(resource.data.routeOwnerId);
    }
    match /gps_reports/{docId} {
      allow get: if isVerifiedMaster() || driverDevice(docId) || dispatchOwnsDevice(docId);
      allow list: if isVerifiedMaster();
      allow create, update: if isVerifiedMaster() || (isActiveDriver() && request.auth.token.driverDeviceId == docId && request.resource.data.deviceId == docId);
      allow delete: if isVerifiedMaster();
    }
    match /gps_requests/{docId} {
      allow get: if isVerifiedMaster() || driverDevice(docId) || dispatchOwnsDevice(docId);
      allow list: if isVerifiedMaster();
      allow create, update: if isVerifiedMaster() || (dispatchOwnsDevice(docId) && request.resource.data.deviceId == docId &&
        request.resource.data.keys().hasOnly(['requestId', 'deviceId', 'requestedAt']));
      allow delete: if isVerifiedMaster();
    }
    match /dispatch_messages/{msgId} {
      allow read: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() &&
        (resource.data.get('senderKey', '') == request.auth.uid || resource.data.get('targetDispatchKey', '') == request.auth.uid ||
         request.auth.uid in resource.data.get('targetLicenseKeys', []))) ||
        (isActiveDriver() && request.auth.token.driverKey in resource.data.get('targetLicenseKeys', []));
      // Dispatcher broadcasts are validated server-side against every selected license.
      allow create: if isVerifiedMaster() || (isActiveDriver() && request.resource.data.senderType == 'DRIVER' &&
        request.resource.data.senderKey == request.auth.token.driverKey &&
        request.resource.data.targetDispatchKey != '' &&
        request.resource.data.targetDispatchKey == get(/databases/$(database)/documents/licenses/$(request.auth.token.driverKey)).data.get('dispatchKey', '') &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 300 &&
        request.resource.data.keys().hasOnly(['senderType','senderKey','senderPhone','senderTitle','targetDispatchKey','targetDeviceIds','targetPhones','content','createdAt','dateStr','timeStr','acknowledged']));
      allow update: if false;
      allow delete: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && resource.data.senderKey == request.auth.uid);
    }
    match /dispatch_templates/{docId} {
      allow read: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && resource.data.dispatchKey in [request.auth.uid, 'MASTER', 'SYSTEM']);
      allow create: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && request.resource.data.dispatchKey == request.auth.uid);
      allow update: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && resource.data.dispatchKey == request.auth.uid && request.resource.data.dispatchKey == request.auth.uid);
      allow delete: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && resource.data.dispatchKey == request.auth.uid);
    }
    match /dispatch_orders/{docId} {
      allow get: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() &&
        docId.replace('^[0-9]{4}-[0-9]{2}-[0-9]{2}_', '') == request.auth.uid);
      allow list: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && resource.data.dispatchKey == request.auth.uid);
      allow create, update: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && request.resource.data.dispatchKey == request.auth.uid &&
        docId == request.resource.data.date + '_' + request.auth.uid);
      allow delete: if isVerifiedMaster() || (request.auth != null && isCurrentDispatcher() && resource.data.dispatchKey == request.auth.uid);
    }

    // 7. 배송 완료 내역 및 주차 메모
    match /completions/{completionId} {
      allow read: if readsOwner(resource.data.routeOwnerId);
      // addDoc 경로는 operation 없음, 큐 경로는 동일 소유자의 complete 확인.
      allow create: if driverOwns(request.resource.data.routeOwnerId) &&
        request.auth.token.driverDeviceId == request.resource.data.deviceId && validCompletion(request.resource.data) &&
        (!existsAfter(/databases/$(database)/documents/completion_operations/$(completionId)) ||
          completionOperationMatches(completionId, request.resource.data.routeOwnerId, 'complete'));
      // 식별정보/배송 내용은 고정하고 사진 후처리와 동일 payload 재전송만 허용.
      allow update: if driverOwns(request.resource.data.routeOwnerId) &&
        request.auth.token.driverDeviceId == request.resource.data.deviceId && validCompletion(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoUrl', 'hasPhoto', 'timeString', 'dispatchKey', 'expireAt']) &&
        (!('expireAt' in resource.data) ||
          request.resource.data.expireAt == resource.data.expireAt) &&
        completionOperationMatches(completionId, request.resource.data.routeOwnerId, 'complete');
      // 기존 관제 직접 삭제 또는 기사 큐의 동일 소유자 delete 마커만 허용.
      allow delete: if isVerifiedMaster() || dispatchOwnsOwner(resource.data.routeOwnerId) ||
        (driverOwns(getAfter(/databases/$(database)/documents/completion_operations/$(completionId)).data.routeOwnerId) && completionDeletionMatches(completionId));
    }
    match /memos/{memoId} {
      allow read: if isWebAdmin() || isActiveDriver();
      // Driver writes use the SMS-verified server endpoint. Master deletion remains available.
      allow create, update: if false;
      allow delete: if isVerifiedMaster();
    }

    // 8. 기기변경 임시 백업 금고
    match /temp_memo_backups/{key} {
      allow read, write: if false;
    }
    // Completion queue compatibility: single-document access only.
    match /completion_operations/{operationId} {
      allow get: if isActiveDriver() && (!exists(/databases/$(database)/documents/completion_operations/$(operationId)) || driverOwns(resource.data.routeOwnerId));
      allow create: if driverOwns(request.resource.data.routeOwnerId) && validCompletionOperation(request.resource.data) &&
        operationResultMatches(operationId, request.resource.data);
      allow update: if driverOwns(request.resource.data.routeOwnerId) && validCompletionOperation(request.resource.data) &&
        request.resource.data.routeOwnerId == resource.data.routeOwnerId &&
        (resource.data.action != 'delete' || request.resource.data.action == 'delete') &&
        operationResultMatches(operationId, request.resource.data);
      allow list, delete: if false;
    }

  }
}
