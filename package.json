{
  "name": "delivery-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "icons:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-android-icons.ps1",
    "firebase:check": "node scripts/check-native-firebase.cjs",
    "postinstall": "node scripts/prepare-capacitor.cjs",
    "build:native": "node scripts/build-native.cjs",
    "cap:add:android": "npm run build:native && cap add android",
    "cap:add:ios": "npm run build:native && cap add ios",
    "cap:sync": "npm run build:native && cap sync",
    "cap:sync:android": "npm run build:native && cap sync android",
    "cap:sync:ios": "npm run build:native && cap sync ios",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.3.0",
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@napi-rs/canvas": "0.1.80",
    "@pdf-lib/fontkit": "1.1.1",
    "@revenuecat/purchases-capacitor": "13.7.4",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "firebase-admin": "^12.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "esbuild": "0.25.12"
  }
}
