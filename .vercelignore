# Default deny: upload only the existing web application and server sources.
/*

!api
!api/**
!server
!server/**
!js
!js/**
!css
!css/**
!icons
!icons/**

!/index.html
!/admin.html
!/admin-dispatch.html
!/admin-master.html
!/error.html
!/terms.html
!/privacy.html
!/policy.html

# Exclude private/configuration JSON except the required root web/build files.
**/*.json
!/package.json
!/package-lock.json
!/vercel.json
!/manifest.json
!/.vercelignore

# Keep sensitive and diagnostic files out even inside an allowed directory.
**/.git/**
**/.vercel/**
**/tests/**
**/node_modules/**
**/benchmarks/**
**/android/**
**/www/**
**/Key store/**
**/.env*
**/*.apk
**/*.aab
**/*.jks
**/*.keystore
**/*.pem
**/*.key
**/*.bak
**/*.log
**/*.tmp
**/*.run-lock
**/*[Hh][Mm][Aa][Cc]*
**/*[Ss][Ee][Cc][Rr][Ee][Tt]*
**/[Bb]ackup*/**
**/*rollback*
**/*synthetic*
**/capacitor.config.json
**/firestore.rules*

/.git/
/.vercel/
/tests/
/node_modules/
/benchmarks/
/android/
/www/
/Key store/
/capacitor.config.json
/firestore.rules
/make-icons.html
