{
  "functions": {
    "api/scan.js": { 
      "maxDuration": 60,
      "memory": 1024
    },
    "api/optimize-llm.js": { 
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "driver.mtsk.co.kr"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mtsk.co.kr"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mtsk.co.kr"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    }
  ]
}