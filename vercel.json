{
  "crons": [
    {
      "path": "/api/memos",
      "schedule": "0 19 * * *"
    }
  ],
  "functions": {
    "api/admin-license-save.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/billing.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/dispatch-payment.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/login.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/memos.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/native-auth-session.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/native-sms.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/optimize-llm.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/payment-confirm.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/scan.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/start-trial.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/tracking.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/invoice-template.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server/NanumGothic*,node_modules/pdfjs-dist/{package.json,legacy/build/**,standard_fonts/**,cmaps/**},node_modules/@napi-rs/canvas*/**/*}"
    }
  },
  "rewrites": [
    {
      "source": "/api/delivery-number",
      "destination": "/api/tracking?operation=delivery-number"
    },
    {
      "source": "/t",
      "destination": "/tracking.html"
    },
    {
      "source": "/t/:code",
      "destination": "/tracking.html"
    },
    {
      "source": "/trial-month",
      "destination": "/index.html"
    },
    {
      "source": "/api/start-trial-month",
      "destination": "/api/start-trial?campaign=sales-month"
    },
    {
      "source": "/favicon.ico",
      "destination": "/icons/site-icon.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/icons/site-icon.png"
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/icons/site-icon.png"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "driver.mtsk.co.kr"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/trial-month/",
      "destination": "/trial-month",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mtsk.co.kr"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mtsk.co.kr"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/t",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/t/:code",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/trial-month",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
