{
  "functions": {
    "api/scan.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "driver.mtsk.co.kr"
        }
      ],
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mtsk.co.kr"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mtsk.co.kr"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    }
  ]
}
