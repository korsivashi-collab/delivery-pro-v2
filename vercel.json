{
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/trial-month",
      "destination": "/index.html"
    },
    {
      "source": "/api/start-trial-month",
      "destination": "/api/start-trial?campaign=sales-month"
    },
    {
      "source": "/favicon.ico",
      "destination": "/icons/site-icon.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/icons/site-icon.png"
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/icons/site-icon.png"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "driver.mtsk.co.kr"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/trial-month/",
      "destination": "/trial-month",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mtsk.co.kr"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mtsk.co.kr"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/trial-month",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
